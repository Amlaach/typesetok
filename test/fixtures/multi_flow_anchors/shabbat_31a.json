{
  "title": "Shabbat 31a",
  "primaryFlow": {
    "id": "gemara",
    "paragraphs": [
      {
        "id": "para_shabbat_31a_gemara_1",
        "text": "<b>שוב מעשה</b> — משנה ראשונה במסכת Shabbat 31a. טקסט הגמרא המרכזי בעימוד צורת הדף."
      }
    ]
  },
  "commentaryFlows": [
    {
      "id": "rashi",
      "paragraphs": [
        {
          "id": "para_shabbat_31a_rashi_1",
          "text": "<b>דעלך סני</b> — פירוש רש\"י המעוגן למשנה ולגמרא."
        }
      ]
    },
    {
      "id": "tosafot",
      "paragraphs": [
        {
          "id": "para_shabbat_31a_tosafot_1",
          "text": "<b>דעלך סני לחברך</b> — ביאור התוספות המעוגן לעמודת החוץ."
        }
      ]
    }
  ],
