// TOK Zero-Copy Binary IPC Schema
namespace TOK.IPC;

enum CommandType : byte {
  InsertText = 0,
  DeleteRange = 1,
  SetStyle = 2,
  ApplyTransaction = 3,
  QueryGeometry = 4,
  HitTest = 5
}

table TextAnchor {
  node_id: string;
  offset_key: string;
  bias_after: bool;
}

table InsertTextCommand {
  anchor: TextAnchor;
  text: string;
}

table DeleteRangeCommand {
  start_anchor: TextAnchor;
  end_anchor: TextAnchor;
}

table HitTestRequest {
  page_index: uint32;
  x_millipoints: int32;
  y_millipoints: int32;
}

table HitTestResponse {
  node_id: string;
  offset_key: string;
  visual_x: int32;
  visual_y: int32;
  line_index: uint32;
}

table GlyphBox {
  cluster: uint32;
  x: int32;
  y: int32;
  width: int32;
  height: int32;
}

table LineBox {
  line_index: uint32;
  baseline_y: int32;
  height: int32;
  glyphs: [GlyphBox];
}

table PageGeometryPayload {
  page_index: uint32;
  gematria_number: string;
  width_pt: float;
  height_pt: float;
  lines: [LineBox];
}

root_type PageGeometryPayload;
